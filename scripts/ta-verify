#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""ta-verify —— test-anything 产物校验器（只读、单文件、仅标准库）。

核对 create / run 在目标工程 tests/ 下产出的目录、命名、追溯锚点与状态文件是否符合
references/ 的现行规则。只校验结构与追溯一致性，不判断用例设计质量，也不代替 run 的
真实测试执行；发现违规时不修改任何文件，修复由 create / run 自身的生成—检查—修复循环完成。

用法：scripts/ta-verify --target <目标工程根目录> [--scope create|run|all] [--json] [--receipt]
      scripts/ta-verify --target <目标工程根目录> --coverage <覆盖率原始文件>
退出码：0 全部通过 / 4 存在确定性违规 / 2 用法错误或目标不可读。

--coverage 是覆盖率解析扩展：只认 coverage JSON、LCOV、Go coverprofile 三类格式，把原始文件
规整为 last_run.json.unit.coverage 的协议对象并以 JSON 输出；与 --scope、--receipt 互斥。

在技能包内运行：不安装、不复制到目标工程，不写任何文件，不访问网络。
"""
import argparse
import ast
import collections
import datetime
import hashlib
import json
import os
import re
import sys

